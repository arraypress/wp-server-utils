{
    "name": "arraypress/wp-server-utils",
    "description": "A lean WordPress library for server environment detection and basic system information",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/arraypress/wp-server-utils/",
    "authors": [
        {
            "name": "David Sherlock",
            "homepage": "https://arraypress.com/"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "autoload": {
        "psr-4": {
            "ArrayPress\\ServerUtils\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/arraypress/wp-server-utils/issues",
        "source": "https://github.com/arraypress/wp-server-utils"
    },
    "keywords": [
        "wordpress",
        "server",
        "environment",
        "hosting",
        "php",
        "system",
        "detection",
        "arraypress",
        "server-info",
        "environment-detection"
    ],
    "require-dev": {
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^3.13.5",
        "wp-coding-standards/wpcs": "^3.4"
    },
    "autoload-dev": {
        "psr-4": {
            "ArrayPress\\ServerUtils\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "format": "phpcbf --standard=phpcs-format.xml.dist",
        "format:check": "phpcs --standard=phpcs-format.xml.dist"
    }
}
